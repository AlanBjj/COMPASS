# Optional. Copy to .env only if the judge runs behind a remote OpenAI-compatible endpoint (a local
# judge, `local: true` in the configs, ignores these). .env is gitignored — never commit real keys.
OPENAI_BASE_URL=https://your-endpoint.example/v1
OPENAI_API_KEY=your-key-here

# Only for the optional live web-search retriever (the paper's runs use the frozen snapshot).
SERPER_API_KEY=your-key-here
